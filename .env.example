# Copy to .env.local and fill in. NEVER commit real credentials.
# On this machine an EDR deletes files containing plaintext Neon credentials,
# so locally store the URL base64-encoded in DATABASE_URL_B64 (db.js decodes it).
# On Vercel, set DATABASE_URL as normal plaintext via `npx vercel env add`.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET=generate-a-long-random-string
